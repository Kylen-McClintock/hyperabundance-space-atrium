# HyperAbundance Community Space Atrium — Environment Configuration
# Copy to .env.local and fill in values for cloud persistence and live Gemini AI.

# 1. Dedicated Habitat Supabase Project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 2. Google Gemini API (Powers signed-in AI Residents: Concierge, LEVL Bartender, AGI Builder Guide)
GOOGLE_GENERATIVE_AI_API_KEY=

# 3. Canonical Sister Platform Origins
NEXT_PUBLIC_AGIFUTURES_URL=https://www.agifutures.org
NEXT_PUBLIC_LEVL_URL=https://levlprotocols.app

# 4. Optional Stage-1 Discord Outbound Announcement Webhook
DISCORD_ANNOUNCEMENT_WEBHOOK_URL=
